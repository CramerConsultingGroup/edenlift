# Eden Lift - Git Ignore

# OS Files
.DS_Store
Thumbs.db
*.log
*~

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak

# Node modules (if npm is used in future)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build outputs and cache
dist/
build/
.cache/
*.min.js
*.min.css

# Environment files
.env
.env.local
.env.*.local

# Temporary test files
/tmp/
*.tmp

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.Python

# Deployment
.vercel
.netlify
.firebase/

# Keep deployment guide
!DEPLOYMENT.md
